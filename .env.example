# Leave DATABASE_URL empty locally: an embedded PGlite database is created in .data/.
# In production, use a Neon connection string (sslmode=require).
DATABASE_URL=

# 32+ random characters. Required in production. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Protects /api/cron/ingest (optional if you only use the GitHub Action).
CRON_SECRET=

# Passcodes used by `npm run seed`. If empty, the seed generates them and
# appends them to .env.local — they are never printed.
SEED_HASSAN_PASSCODE=
SEED_WHITNEY_PASSCODE=

# Optional: Research (/research). A free key from aistudio.google.com; it can also be pasted
# in Settings → AI research instead. GEMINI_MODELS overrides the models tried, in order.
GEMINI_API_KEY=
GEMINI_MODELS=

# Optional: a TURN relay so calls connect on strict mobile networks (set one group), or paste
# it in Settings → Call relay instead. See DEPLOY.md.
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=
METERED_TURN_DOMAIN=
METERED_TURN_API_KEY=
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=
