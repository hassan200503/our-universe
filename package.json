{
  "name": "our-universe",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/migrate.ts",
    "seed": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/seed.ts",
    "ingest": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/ingest.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "retag": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/retag.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@tanstack/react-query": "^5.104.0",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.3",
    "fast-xml-parser": "^5.11.1",
    "jose": "^6.2.12",
    "next": "16.3.6",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.19.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.2"
  }
}
